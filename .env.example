# Build configuration; actual non-secret Worker vars are in wrangler.toml.
BUILD_TARGET=cloudflare
NEXT_PUBLIC_STORAGE_TYPE=d1
NEXT_TELEMETRY_DISABLED=1
SITE_BASE=https://tv.vafa.eu.org
# Provision these with Wrangler Secrets; never deploy placeholder values.
USERNAME=
PASSWORD=
CRON_PASSWORD=
DISABLE_PUBLIC_PROXIES=true
DANMAKU_ENABLED=false
# Future VPS integration only, after actual DNS/HTTPS/service verification.
# Existing D1 SiteConfig takes priority: set custom base/token in admin panel.
DANMAKU_API_BASE=
DANMAKU_API_TOKEN=
# Optional browser-side cache lifetime (minutes).
NEXT_PUBLIC_DANMAKU_CACHE_EXPIRE_MINUTES=4320
